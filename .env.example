# Copy to .env.local for local development. Nothing here is required locally:
# PGlite (embedded Postgres) and the Claude Code CLI are used when these are empty.

# Postgres connection (Supabase: use the transaction pooler URI, port 6543). Required in production.
DATABASE_URL=

# HMAC key for sign-in codes, at least 32 random characters (e.g. `openssl rand -hex 32`). Required in production.
SESSION_SECRET=

# Anthropic API key for AIRA in production. Without it, local development uses the Claude Code CLI.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Demo personas and the on-screen sign-in codes (no email provider). On in development; off in production unless 1.
DEMO_MODE=

# Minimum distinct contributing organisations before a theme's details are shared.
MIN_ORGS=3
